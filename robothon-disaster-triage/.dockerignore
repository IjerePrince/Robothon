# Disaster Triage Robothon — .dockerignore
# Reduces Docker build context size.

.git
.github
.gitignore
__pycache__/
*.py[cod]
*.so
*.egg-info/
build/
dist/
.eggs/
.pytest_cache/
.coverage
htmlcov/
.tox/
.env
.venv
venv/
env/
.idea/
.vscode/
*.swp
*.swo
.DS_Store
*.log
checkpoints/*
!checkpoints/.gitkeep
demos/*
!demos/demo.mp4
logs/
docs/
*.md
!README.md
